# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real keys.

# Resend (https://resend.com) - used by /api/contact and /api/survey to
# deliver submissions by email. Create an API key in the Resend dashboard.
# If this is unset, submissions are still accepted and appended to
# ./data/*.jsonl on the server so nothing is lost during local development.
RESEND_API_KEY=

# Where submission notifications are sent.
CONTACT_TO_EMAIL=cecyintelligence@afrihealthIQ.com

# The verified sender address for your Resend domain. Until you verify a
# domain, Resend only allows onboarding@resend.dev as the from address.
CONTACT_FROM_EMAIL=onboarding@resend.dev
